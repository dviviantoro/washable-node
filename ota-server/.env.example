# Copy to .env and fill in. Never commit .env.

# Listen on loopback only: the Cloudflare tunnel connects here. Do not expose it directly.
HOST=127.0.0.1
PORT=8787

# Admin login for the dashboard (min 8 chars) and the key that signs its session tokens (min 32 chars).
ADMIN_PASSWORD=change-me-please
JWT_SECRET=generate-with-openssl-rand-hex-32

# Browser origins allowed to call /api/* (your Vercel domain). Comma separated; "https://*.vercel.app" style wildcards work.
ALLOWED_ORIGINS=http://localhost:3000,https://your-dashboard.vercel.app

# Optional: public https URL of the tunnel, used only to print the manifest URL in the dashboard.
# Empty = derived from the request Host header.
PUBLIC_URL=

# Optional
# REPO_DIR=..            # git checkout the code editor copies esp32-kiosk/ from
# PIO_BIN=./data/tools/pio-venv/bin/pio
# EMSDK_DIR=./data/tools/emsdk
# DATA_DIR=./data
# EVENT_RETENTION_DAYS=90
# TOKEN_TTL=12h
