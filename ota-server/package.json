{
  "name": "washable-ota-server",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted OTA firmware backend for the washable kiosk (manifest.json + firmware.bin for the ESP32, admin API for the dashboard)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.4.3",
    "@fastify/jwt": "10.2.7",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "11.2.2",
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
